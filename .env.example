# Environment Variables

# Optional: Unsplash API Access Key
# Get your key at: https://unsplash.com/developers
# Without this, you'll use the public Unsplash URLs with rate limits
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# Optional: Supabase realtime sticky notes
# Create a Supabase project and run supabase/sticky_notes_schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sticky notes realtime feature flag
# true (default) = use Supabase realtime if configured
# false = force localStorage-only sticky notes
NEXT_PUBLIC_STICKY_NOTES_REALTIME=true

# Optional: Custom audio CDN or file paths
# NEXT_PUBLIC_AUDIO_CDN_URL=
